{
  "name": "prompt-cost",
  "displayName": "Prompt Cost",
  "description": "Estimate LLM token usage and API cost for a prompt, attached files, or two prompt versions. Counts run locally. No API key is required.",
  "version": "1.0.6",
  "publisher": "prompt-cost",
  "license": "MIT",
  "homepage": "https://github.com/MhamedR/Prompt-Cost",
  "bugs": {
        "url": "https://github.com/MhamedR/Prompt-Cost"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "token",
    "tokenizer",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "llama",
    "mistral",
    "deepseek",
    "cost",
    "prompt",
    "mcp"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MhamedR/Prompt-Cost.git"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "promptCost.analyzeDocument",
        "title": "Analyze Current Document",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.analyzeSelection",
        "title": "Analyze Selected Text",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.open",
        "title": "Open Prompt Cost",
        "category": "Prompt Cost",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "promptCost.comparePrompts",
        "title": "Compare Prompts",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.countWithProviderApi",
        "title": "Count Tokens with Provider API",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.setApiKey",
        "title": "Store Provider API Key",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.clearApiKey",
        "title": "Clear Provider API Key",
        "category": "Prompt Cost"
      },
      {
        "command": "promptCost.configureMcp",
        "title": "Configure MCP Server",
        "category": "Prompt Cost"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "promptCost.analyzeSelection",
          "when": "editorHasSelection",
          "group": "promptCost@1"
        },
        {
          "command": "promptCost.analyzeDocument",
          "group": "promptCost@2"
        },
        {
          "command": "promptCost.comparePrompts",
          "group": "promptCost@3"
        }
      ],
      "commandPalette": [
        {
          "command": "promptCost.analyzeSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "promptCost.servers",
        "label": "Prompt Cost"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompt-cost",
          "title": "Prompt Cost",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "prompt-cost": [
        {
          "type": "webview",
          "id": "promptCost.dashboard",
          "name": "Prompt Cost",
          "contextualTitle": "Prompt Cost"
        }
      ]
    },
    "configuration": {
      "title": "Prompt Cost",
      "properties": {
        "promptCost.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "llama",
            "mistral",
            "deepseek"
          ],
          "default": "openai",
          "description": "Provider used before a selection is saved in the sidebar."
        },
        "promptCost.defaultModel": {
          "type": "string",
          "default": "gpt-5.4",
          "description": "Model id used before a selection is saved in the sidebar."
        },
        "promptCost.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the token and cost estimate in the status bar."
        },
        "promptCost.statusBar.source": {
          "type": "string",
          "enum": [
            "auto",
            "document",
            "selection"
          ],
          "enumDescriptions": [
            "Count the selection when it is not empty, otherwise the document.",
            "Always count the full document.",
            "Count the selection. An empty selection counts as zero tokens."
          ],
          "default": "auto",
          "description": "The status bar shows the prompt in the sidebar. Document and Selection copy editor text into that prompt."
        },
        "promptCost.expectedOutputTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 0,
          "description": "Output tokens assumed by the cost estimate. The extension cannot know how long a completion will be."
        },
        "promptCost.maxCharacters": {
          "type": "number",
          "default": 1000000,
          "minimum": 1000,
          "description": "Documents longer than this are not tokenized, so the extension host stays responsive."
        },
        "promptCost.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "description": "Wait this long after a keystroke before recounting."
        },
        "promptCost.apiCounting.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow an explicit action to send the analyzed text to Anthropic or Google for an official token count. Live counting stays on this machine. Keys stay in the extension secret store."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "publish:marketplace": "vsce publish --no-dependencies",
    "publish:openvsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "ovsx": "^0.10.5",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@cyberlangke/tokkit-deepseek": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai-tokenizer": "^1.0.7",
    "gpt-tokenizer": "^4.1.0",
    "llama3-tokenizer-js": "^1.2.0",
    "mistral-tokenizer-ts": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  }
}
